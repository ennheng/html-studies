name: Build gallery and deploy Pages
on:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: true
jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install playwright pillow
      - run: python -m playwright install --with-deps chromium
      - run: python scripts/capture_screenshots.py
      - run: python scripts/build_gallery.py
      - uses: actions/configure-pages@v5
      - name: Package site
        run: |
          mkdir -p _site
          cp *.html *.txt favicon.svg .nojekyll _site/
          cp -r thumbs _site/
          cp studies.json preview.jpg _site/ 2>/dev/null || true
      - uses: actions/upload-pages-artifact@v3
        with:
          path: _site
  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
